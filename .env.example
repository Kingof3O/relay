APP_NAME=Relay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FFMPEG_BINARY=/usr/bin/ffmpeg
FFPROBE_BINARY=/usr/bin/ffprobe
REQUEST_MAX_FILE_SIZE_KB=512000
REQUEST_BULK_CHUNK_SIZE=25
REQUEST_STORAGE_DISK=local
 
# OAuth & Social Sign-In (Enable/disable or provide client credentials)
AUTH_GITHUB_ENABLED=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

AUTH_GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Discord Bot & Incoming Webhook Integration
DISCORD_NOTIFICATIONS_ENABLED=false
DISCORD_WEBHOOK_URL=
DISCORD_BOT_USERNAME="Relay Studio"
DISCORD_BOT_AVATAR_URL=

# ==============================================================================
# RELAY STUDIO CONFIGURABLE FEATURE TOGGLES & AUTOMATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Automated Backups & Disaster Recovery
# ------------------------------------------------------------------------------
# Set to false to disable automated background backups completely
RELAY_BACKUP_ENABLED=false

# Whether automated backups archive user uploaded files/attachments (true) or database only (false)
RELAY_BACKUP_INCLUDE_FILES=false

# Cron schedule for automated backups (default: 02:00 AM UTC daily)
RELAY_BACKUP_SCHEDULE="0 2 * * *"

# Number of days to retain backup archives before auto-pruning (0 to never prune)
RELAY_BACKUP_RETENTION_DAYS=14

# Destination directory for backup archives (leave blank for storage/app/backups)
RELAY_BACKUP_DIR=

# ------------------------------------------------------------------------------
# 2. Agile & Background Automation
# ------------------------------------------------------------------------------
# Set to false to disable automatic cycle rollover when cycles expire
RELAY_AUTO_ROLLOVER_ENABLED=true

# Time of day (UTC) to run cycle rollover (default: 00:05 UTC)
RELAY_AUTO_ROLLOVER_TIME="00:05"

# ------------------------------------------------------------------------------
# 3. Webhooks & Integrations Master Toggles
# ------------------------------------------------------------------------------
# Master toggle for all outgoing webhook jobs (Discord, Slack, Custom Webhooks)
RELAY_OUTGOING_WEBHOOKS_ENABLED=true

# Dedicated toggle for Discord alerts
RELAY_DISCORD_ENABLED=true

# Dedicated toggle for Slack notifications
RELAY_SLACK_ENABLED=true

# Dedicated toggle for GitHub webhook synchronization
RELAY_GITHUB_SYNC_ENABLED=true

# Dedicated toggle for Inbound Email webhook comments
RELAY_INBOUND_EMAIL_ENABLED=true

# ------------------------------------------------------------------------------
# 4. Real-Time Collaboration & Presence
# ------------------------------------------------------------------------------
# Set to false if running without Reverb / WebSockets
RELAY_REALTIME_ENABLED=true

# ------------------------------------------------------------------------------
# 5. Governance & Audit Logging
# ------------------------------------------------------------------------------
# Set to false to disable database audit trail writes
RELAY_AUDIT_ENABLED=true
RELAY_AUDIT_RETENTION_DAYS=90

# ------------------------------------------------------------------------------
# 6. User Interface & Demo Controls
# ------------------------------------------------------------------------------
# Set to true to show quick demo credentials on the login screen
RELAY_SHOW_DEMO_CREDENTIALS=false

